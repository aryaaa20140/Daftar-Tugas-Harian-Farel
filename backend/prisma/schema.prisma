generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  subject     String
  dueDate     DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
}